# Disable autocrlf on generated files, they always generate with LF
# Add any extra files or paths here to make git stop saying they
# are changed when only line endings change.
src/generated/**/.cache/* text eol=lf
src/generated/**/*.json text eol=lf

# The jar's text resources as the repository has them (LF), whatever core.autocrlf says: a CRLF options.tsv left a
# "\r" in its last column and locked every switch of the settings screen (1.0.x - 1.1.1)
src/main/resources/**/*.tsv text eol=lf
src/main/resources/**/*.txt text eol=lf
src/main/resources/**/*.json text eol=lf
src/main/resources/**/*.toml text eol=lf
src/main/resources/**/*.cfg text eol=lf
src/main/templates/**/*.toml text eol=lf
defaults.txt text eol=lf
